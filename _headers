# _headers
/*
  X-Content-Type-Options: nosniff

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: no-cache, must-revalidate

/manifest.json
  Cache-Control: public, max-age=86400

/ngsw.json
  Cache-Control: no-cache, must-revalidate

/ngsw-worker.js
  Cache-Control: public, max-age=86400
